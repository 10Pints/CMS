<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CMS.Maui.CustomerPage"
             Title="Customers">
   <StackLayout Margin="20" Spacing="0">

      <!-- HEADER GRID -->
      <Grid Padding="1" BackgroundColor="Black">
         <Grid BackgroundColor="#512BD4" Padding="0">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="80" />
               <ColumnDefinition Width="0.5*" />
               <ColumnDefinition Width="0.5*" />
            </Grid.ColumnDefinitions>

            <!-- ID Header -->
            <Frame Padding="10,5" BackgroundColor="Transparent" BorderColor="Black" HasShadow="False"
                       Margin="0" HorizontalOptions="Fill">
               <Label Text="ID"
                      TextColor="White"
                      FontSize="14"
                      FontAttributes="Bold"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"/>
            </Frame>

            <!-- Name Header -->
            <Frame Grid.Column="1" Padding="10,5" BackgroundColor="Transparent" BorderColor="Black" 
                       HasShadow="False" Margin="0" HorizontalOptions="Fill">
               <Label Text="Name"
                      TextColor="White"
                      FontSize="14"
                      FontAttributes="Bold"
                      HorizontalOptions="Start"
                      VerticalOptions="Center"/>
            </Frame>

            <!-- Email Header -->
            <Frame Grid.Column="2" Padding="10,5" BackgroundColor="Transparent" BorderColor="Black" 
                   HasShadow="False" Margin="0" HorizontalOptions="Fill">
               <Label Text="Email"
                      TextColor="White"
                      FontSize="14"
                      FontAttributes="Bold"
                      HorizontalOptions="Start"
                      VerticalOptions="Center"/>
            </Frame>
         </Grid>
      </Grid>

        <!-- DATA GRID-->
      <CollectionView ItemsSource="{Binding Customers}" 
                        Margin="0,-1,0,0"
                        x:Name="CustomersCollection">
         <CollectionView.ItemTemplate>
            <DataTemplate>
               <Grid Padding="1" BackgroundColor="Black">
                  <Grid Padding="0"
                        BackgroundColor="White"> <!-- Default color -->
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.5*" />
                     </Grid.ColumnDefinitions>

                     <!-- Customer ID -->
                     <Frame Padding="10,5" BackgroundColor="Transparent" BorderColor="Black" 
                            HasShadow="False" Margin="0" HorizontalOptions="Fill">
                        <Label Text="{Binding CustomerId}"
                               FontSize="14"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                     </Frame>

                     <!-- Name -->
                     <Frame Grid.Column="1" Padding="10,5" BackgroundColor="Transparent" BorderColor="Black" 
                            HasShadow="False" Margin="0" HorizontalOptions="Fill">
                        <Label Text="{Binding Name}"
                               FontSize="14"
                               HorizontalOptions="Start"
                               VerticalOptions="Center"/>
                     </Frame>

                     <!-- Email -->
                     <Frame Grid.Column="2" Padding="10,5" BackgroundColor="Transparent" BorderColor="Black" 
                            HasShadow="False" Margin="0" HorizontalOptions="Fill">
                        <Label Text="{Binding Email}"
                               FontSize="12"
                               TextColor="Gray"
                               HorizontalOptions="Start"
                               VerticalOptions="Center"/>
                     </Frame>
                  </Grid>
               </Grid>
            </DataTemplate>
         </CollectionView.ItemTemplate>

         <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
         </CollectionView.ItemsLayout>
      </CollectionView>

      <!-- Load Button -->
      <Button Text="Load Customers"
              Command="{Binding LoadCustomersCommand}" 
              BackgroundColor="#512BD4"
              WidthRequest="200"
              HorizontalOptions="Center"
              TextColor="White"
              Margin="0,20,0,0"
              HeightRequest="50"
              CornerRadius="10"/>
   </StackLayout>
</ContentPage>