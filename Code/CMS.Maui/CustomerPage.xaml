<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CMS.Maui.Converters"
             x:Class="CMS.Maui.CustomerPage"
             Title="Customers">
    
    <ContentPage.Resources>
        <converters:RowColorConverter x:Key="RowColorConverter" />
    </ContentPage.Resources>
    
   <StackLayout Margin="20">
      <!-- Header Grid -->
      <Grid BackgroundColor="#512BD4" Padding="10">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
         </Grid.ColumnDefinitions>

         <Label Text="ID" 
                   TextColor="White" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

         <Label Text="Name" 
                   TextColor="White" 
                   FontAttributes="Bold"
                   Grid.Column="1"
                   HorizontalOptions="Center"/>

         <Label Text="Email" 
                   TextColor="White" 
                   FontAttributes="Bold"
                   Grid.Column="2"
                   HorizontalOptions="Center"/>
      </Grid>

      <!-- Customers List with Alternating Colors -->
      <CollectionView ItemsSource="{Binding Customers}">
         <CollectionView.ItemTemplate>
            <DataTemplate>
               <Grid Padding="10"
                  BackgroundColor="{Binding ., 
                  Converter={StaticResource RowColorConverter},
                  ConverterParameter={Binding Index}}">
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="0.5*" />
                     <ColumnDefinition Width="1*" />
                     <ColumnDefinition Width="1*" />
                  </Grid.ColumnDefinitions>

                  <!-- Customer ID -->
                  <Label Text="{Binding CustomerId}" 
                               FontSize="14"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>

                  <!-- Name -->
                  <Label Text="{Binding Name}" 
                               FontSize="14"
                               Grid.Column="1"
                               HorizontalOptions="Start"
                               VerticalOptions="Center"/>

                  <!-- Email (if available) -->
                  <Label Text="{Binding Email}" 
                               FontSize="12"
                               TextColor="Gray"
                               Grid.Column="2"
                               HorizontalOptions="Start"
                               VerticalOptions="Center"/>
               </Grid>
            </DataTemplate>
         </CollectionView.ItemTemplate>

         <!-- Alternating row colors -->
         <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="1" />
            </CollectionView.ItemsLayout>
      </CollectionView>

      <!-- Load Button -->
      <Button Text="Load Customers" 
      Command="{Binding LoadCustomersCommand}" 
                BackgroundColor="#512BD4"
                TextColor="White"
                Margin="0,20,0,0"
                HeightRequest="50"
                CornerRadius="10"/>

      <Button Text="Load Customers" 
              Command="{Binding LoadCustomersCommand}" 
              BackgroundColor="#512BD4"
              TextColor="White"
              Margin="0,20,0,0"
              HeightRequest="50"
              CornerRadius="10"/>
   </StackLayout>
</ContentPage>